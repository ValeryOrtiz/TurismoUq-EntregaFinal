graph G {
  graph [layout=neato, overlap=false, splines=true, sep="+12", fontname="Arial", bgcolor="white", pad=0.3];
  node [fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=11, fontcolor="#b00020"];
  /* entidades existentes (gris) y agregadas (azul) */
  ALOJ [label="ALOJAMIENTO", shape=box, style=filled, fillcolor="#eeeeee", pos="0,0!"];
  TAR  [label="TARIFA", shape=box, peripheries=2, style=filled, fillcolor="#eeeeee", pos="0,-4!"];
  RES  [label="RESERVA", shape=box, style=filled, fillcolor="#eeeeee", pos="7,-4!"];
  RH   [label="RESERVA_HABITACION", shape=box, style=filled, fillcolor="#eeeeee", pos="7,-8!"];
  US   [label="USUARIO_SISTEMA", shape=box, style=filled, fillcolor="#eeeeee", pos="7,2!"];
  LIQ  [label="LIQUIDACION_MENSUAL", shape=box, style=filled, fillcolor="#dbe8f7", pos="-6,0!"];
  AUD  [label="AUDITORIA_TARIFA", shape=box, style=filled, fillcolor="#dbe8f7", pos="-6,-4!"];
  HIS  [label="RESERVA_HISTORICO", shape=box, style=filled, fillcolor="#dbe8f7", pos="13,-4!"];
  CAL  [label="CALENDARIO", shape=box, style=filled, fillcolor="#dbe8f7", pos="0,-8!"];
  /* relaciones */
  r1 [label="SE_LIQUIDA", shape=diamond, style=filled, fillcolor="#fff4c2", pos="-3,0!"];
  r2 [label="REGISTRA_CAMBIO", shape=diamond, style=filled, fillcolor="#fff4c2", pos="-3,-4!"];
  r3 [label="SE_ARCHIVA", shape=diamond, style=filled, fillcolor="#fff4c2", pos="10,-4!"];
  ALOJ -- r1 [label="1"]; r1 -- LIQ [label="N", color="black:invis:black"];
  TAR -- r2 [label="1"]; r2 -- AUD [label="N", color="black:invis:black"];
  RES -- r3 [label="1"]; r3 -- HIS [label="1"];
  /* atributos clave de las agregadas */
  a1 [label=<<u>liquidacion_id</u>>, shape=ellipse, pos="-8.5,1.2!"];
  a2 [label="anio, mes", shape=ellipse, pos="-6,1.4!"];
  a3 [label="valor_bruto, comision, neto", shape=ellipse, pos="-8.3,-1.2!"];
  a4 [label=<<u>auditoria_id</u>>, shape=ellipse, pos="-8.5,-2.8!"];
  a5 [label="id_sentencia, operacion", shape=ellipse, pos="-8.6,-5.0!"];
  a6 [label="precio_anterior, precio_nuevo", shape=ellipse, pos="-6,-5.6!"];
  a7 [label="usuario_bd, fecha_hora", shape=ellipse, pos="-3.8,-5.6!"];
  a8 [label=<<u>reserva_id</u>>, shape=ellipse, pos="15.2,-2.8!"];
  a9 [label="total_pagado, fecha_archivo", shape=ellipse, pos="14.6,-5.4!"];
  a10 [label=<<u>fecha</u>>, shape=ellipse, pos="-2.2,-9.0!"];
  a11 [label="anio, mes, dia", shape=ellipse, pos="2.2,-9.0!"];
  LIQ -- a1; LIQ -- a2; LIQ -- a3; AUD -- a4; AUD -- a5; AUD -- a6; AUD -- a7;
  HIS -- a8; HIS -- a9; CAL -- a10; CAL -- a11;
  /* atributos nuevos en entidades existentes */
  n1 [label="fecha_cancelacion", shape=ellipse, style=filled, fillcolor="#dbe8f7", pos="7,-1.8!"];
  n2 [label="num_huespedes", shape=ellipse, style=filled, fillcolor="#dbe8f7", pos="10,-8!"];
  n3 [label="usuario_bd", shape=ellipse, style=filled, fillcolor="#dbe8f7", pos="10,2!"];
  RES -- n1; RH -- n2; US -- n3;
  RES -- RH [style=invis];
  ley [shape=plaintext, pos="4,-10.4!", label=<<font point-size="10">Azul: entidades y atributos agregados en las Entregas 2 y 3. Gris: entidades del MER de la Entrega 1.<br/>Linea doble: participacion total. CALENDARIO es una tabla de apoyo sin relaciones (reparte las noches por mes).</font>>];
}
